# Security Headers for all routes
/*
  # Cache Control
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

  # CSP는 Worker (src/worker/index.ts) 에서 동적으로 발급한다.
  # 여기서 중복 선언하면 정책이 충돌·병합되어 의도치 않게 느슨해질 수 있음.
  # (하드닝된 CSP · CSP reporting · nonce/hash 정책은 Worker 쪽에서 단일 관리)

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Clickjacking Protection (SAMEORIGIN — live 페이지 임베드 허용)
  X-Frame-Options: SAMEORIGIN

  # Referrer Policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions Policy
  # 🛡️ 2026-04-27: geolocation=(self) — MainHomePage 의 GPS 자동 지역 감지 허용
  # 🛡️ 2026-05-13: autoplay=* / fullscreen=* / picture-in-picture=* / encrypted-media=*
  #   추가 — YouTube iframe 라이브 재생 사고. 기존엔 autoplay 미선언 → 브라우저 기본 'self'
  #   적용 → cross-origin YouTube iframe 의 autoplay 차단 → 시청자 페이지에서 클릭해도 무반응.
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(self), payment=(self), usb=(), interest-cohort=(), autoplay=*, fullscreen=*, picture-in-picture=*, encrypted-media=*

  # Strict Transport Security (HSTS)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # 🛡️ 2026-04-29: Cross-Origin-Opener-Policy — Spectre/사이드채널 방어.
  #   same-origin-allow-popups 로 OAuth popup (Google/Kakao consent) 호환 유지.
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Cache control for static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 🔤 2026-10-12 (대표 승인 "둘 다 자가호스팅" — 라이브 실측): 자가호스팅 폰트에 1년 immutable.
#   그 전까지 `/static/fonts/*` 는 맨 위 `/*` 의 `no-cache, no-store, must-revalidate` 에 걸려 있었고
#   라이브 실측 `cf-cache-status: BYPASS` 였다 — 우리가 들여온 숫자 폰트 5개(31KB)만 캐시가 금지되고
#   매 요청이 오리진까지 갔다. 정작 남의 CDN(jsdelivr)은 1년 immutable 이다.
#   ⚠️ 이 블록을 지우면 폰트 CSS(12KB)와 숫자 폰트가 **매 방문마다** 다시 받아진다. 지우지 말 것.
#   🔒 immutable 이 안전한 이유: 이 폴더의 파일명에 버전이 박혀 있다(`…-v1.3.9.css`, `…-v24.woff2`,
#      `roboto-digits-v2-{400..800}.woff2` — 내용이 바뀌면 파일명이 바뀐다). 같은 이름으로 내용만
#      바꾸면 1년간 옛 파일이 남으므로, **교체는 반드시 새 파일명으로** 할 것.
#   🩸 2026-10-12 **위 블록은 효과가 없었다(라이브 실측)**: Pages 는 맞는 규칙의 헤더를 **전부 합친다** —
#      실제 응답이 `Cache-Control: no-cache, no-store, must-revalidate, public, max-age=31536000, immutable`
#      + `Pragma: no-cache` + `Expires: 0`, `cf-cache-status: BYPASS` 였다(no-store 가 이긴다).
#      맨 위 `/*` 가 붙인 세 헤더를 `!` 로 **떼고** 다시 단다. `/assets/*` 가 멀쩡했던 건 워커가 서빙하기
#      때문이다(`_routes.json` 에서 제외되지 않아 이 파일이 적용되지 않는다).
/static/fonts/*
  ! Cache-Control
  ! Pragma
  ! Expires
  Cache-Control: public, max-age=31536000, immutable

# No cache for HTML files
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# API routes - no cache + additional security
/api/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY

# Auth routes - no cache + strict security
/auth/*
  Cache-Control: no-store, no-cache, must-revalidate
  Pragma: no-cache
  Expires: 0
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# PWA manifest - MIME type (avoids "Manifest: Line: 1 Syntax error" in Chrome)
/manifest.webmanifest
  ! Cache-Control
  ! Pragma
  ! Expires
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=3600

/*.webmanifest
  Content-Type: application/manifest+json; charset=utf-8

# 🛡️ 2026-04-30: Universal Link / App Link 파일 (Apple/Google 검증)
#   apple-app-site-association: 확장자 없음, application/json 필수
#   assetlinks.json: 동일
/.well-known/apple-app-site-association
  ! Cache-Control
  ! Pragma
  ! Expires
  Content-Type: application/json
  Cache-Control: public, max-age=86400

/.well-known/assetlinks.json
  ! Cache-Control
  ! Pragma
  ! Expires
  Content-Type: application/json
  Cache-Control: public, max-age=86400
