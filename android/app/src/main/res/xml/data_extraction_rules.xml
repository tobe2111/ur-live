<?xml version="1.0" encoding="utf-8"?>
<!-- 🛡️ 2026-07-18: Manifest 의 android:dataExtractionRules 참조 대상 (Android 12+ 백업 규칙).
     AndroidManifest 가 allowBackup=false 라 백업/기기이전 모두 제외 — 세션 쿠키/토큰이
     타 기기로 복사되는 것 방지(웹뷰 앱의 세션 보안). 빌드 #2 AAPT 'resource not found' 수리. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
