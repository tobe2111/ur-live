{
  "mcpServers": {
    "tosspayments": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@tosspayments/integration-guide-mcp"
      ]
    },
    "21st": {
      "type": "http",
      "url": "https://21st.dev/api/mcp",
      "headers": {
        "x-api-key": "${API_KEY_21ST}"
      }
    }
  }
}
