# Dependencies
node_modules/

# Build outputs
dist/
*.js
!*.config.js
!vite.config.js
!tailwind.config.js
!playwright.config.js
!postcss.config.js
!scripts/**/*.js
!naver-ad-scraper/**/*.js
# 🛡️ public/ 의 정적 SW 들은 추적 (PWA/push/killer)
!public/sw.js
!public/pwa-sw.js
!public/push-sw.js

# Wrangler local state
.wrangler/

# Environment files (never commit secrets)
.dev.vars
.env
.env.*
!.env.example
!.env.*.example
!.env.*.template
!.env.production
# 🚨 2026-07-28: `.env.deploy` 가 살아있는 CLOUDFLARE_API_TOKEN 을 담은 채 public 레포에 커밋돼 있었다(#737).
#   위 `.env.*` 규칙이 있었는데도 `git add -f` 로 들어왔다 → 되돌리지 못하게 예외를 명시적으로 좁혀 둔다.
#   (배포 토큰은 GitHub Actions Secrets / Cloudflare 대시보드에만 둘 것 — 레포엔 어떤 형태로도 금지.)
.env.deploy

# 🚨 2026-07-28: 키 파일 자체를 확장자로 차단 — archive/ 에 Google 서비스계정 개인키가 3개월간
#   추적된 채 public 노출됐다(#798). 파일로 받아 레포에 두는 습관 자체를 막는다.
#   (서비스계정 JSON 은 GCP 콘솔에서 받자마자 Cloudflare Secret 으로 옮기고 로컬 파일은 지울 것.)
*.pem
*.p12
*.pfx
*.key
*service-account*.json
*serviceaccount*.json
*-credentials.json


